FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
# Runtime secrets (set via deploy environment, not baked into the image):
# ADMIN_TOKEN, GITHUB_ENABLED, GITHUB_TOKEN, GITHUB_OWNER, GITHUB_REPO, GITHUB_BRANCH, GITHUB_PR_FLOW
RUN apt-get update && apt-get install -y --no-install-recommends build-essential gcc && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt
COPY . /app
RUN mkdir -p /opt/rednode/data && chown -R root:root /opt/rednode
RUN useradd -m -d /home/rednode -s /bin/false rednode || true && chown -R rednode:rednode /app /opt/rednode
USER rednode
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
