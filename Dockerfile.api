FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1     PYTHONUNBUFFERED=1

WORKDIR /app

# Runtime secrets (set via deploy environment, not baked into the image):
# ADMIN_TOKEN, GITHUB_ENABLED, GITHUB_TOKEN, GITHUB_OWNER, GITHUB_REPO, GITHUB_BRANCH, GITHUB_PR_FLOW
RUN apt-get update  && apt-get install -y --no-install-recommends     build-essential     gcc     curl     libglib2.0-0     libsm6     libxext6     libxrender1  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

RUN mkdir -p /opt/watchtower/data  && chown -R root:root /opt/watchtower  && useradd -m -d /home/watchtower -s /bin/false watchtower || true  && chown -R watchtower:watchtower /app /opt/watchtower

USER watchtower

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3   CMD curl -fsS --connect-timeout 2 "http://127.0.0.1:${PORT:-8000}/healthz" || exit 1

CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
